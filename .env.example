# The identity shared by every client of this remote MCP.
AGENTHANSA_API_KEY=replace-me

# Protect the remote MCP endpoint for generic MCP clients.
MCP_AUTH_MODE=bearer
MCP_ACCESS_TOKEN=replace-with-a-long-random-secret

PORT=8080
HOST=0.0.0.0

# Upstream identity registration is blocked by default on the remote bridge.
# Set to an empty string to expose every upstream tool.
MCP_BLOCKED_TOOLS=register_agent

# 1 = JSON response mode (default); 0 = SSE response on POST where supported.
MCP_JSON_RESPONSE=1
